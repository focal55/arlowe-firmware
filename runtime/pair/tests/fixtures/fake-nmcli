#!/usr/bin/env python3
"""Scripted nmcli for the pairing tests and the E2E. Stdlib only.

Environment:
  FAKE_NMCLI_SCENARIO  JSON object, inline or a path to a file. Keys:
                         scan   [{"ssid", "signal", "security"}] for `device wifi list`
                         ap_up  "ok" (default) or "fail"
                         ip4    `-g IP4.ADDRESS device show` output, e.g. "10.0.0.5/24"
                         join   {"correct_psk": S} fails `up` of a non-AP profile
                                with (7) unless the passwd-file psk equals S;
                                {"exit": N, "stderr": S} fails it as scripted
  FAKE_NMCLI_LOG       every argv is appended here as one JSON line
  FAKE_NMCLI_STATE     JSON profile list {"profiles": [...]}, keyed by uuid;
                       `connection add` creates, `delete` removes, `show` prints

A passwd-file secret is read and never stored: the profile records only
"secret_supplied". The real rules are nmc_utils_parse_passwd_file
(src/libnmc-base/nm-client-utils.c) and nm_utils_buf_utf8safe_unescape with
STRIP_SPACES (src/libnm-glib-aux/nm-shared-utils.c) at NetworkManager tag 1.42.4;
read_passwd_file ports both, so the daemon's escaping is tested against them.
"""
import json
import os
import re
import sys

NOT_FOUND = 10
SPACE = b" \t\n\v\f\r"
ESCAPES = {ord(k): ord(v) for k, v in zip("bfnrtv", "\b\f\n\r\t\v")}


def unescape(s):
    s = s.lstrip(SPACE)
    out, i = bytearray(), 0
    while True:
        j = s.find(b"\\", i)
        if j < 0:
            return bytes(out + s[i:].rstrip(SPACE))
        out += s[i:j]
        j += 1
        if j == len(s):
            return bytes(out)
        if 0x30 <= s[j] <= 0x39:
            v, j = s[j] - 0x30, j + 1
            for _ in range(2):
                if j < len(s) and 0x30 <= s[j] <= 0x37:
                    v, j = v * 8 + s[j] - 0x30, j + 1
            out.append(v & 0xFF)
        else:
            out.append(ESCAPES.get(s[j], s[j]))
            j += 1
        i = j


def read_passwd_file(path):
    with open(path, "rb") as f:
        data = f.read()
    pwds = {}
    for line in re.split(rb"\r\n|\r|\n", data):
        line = line.lstrip(SPACE)
        if not line or line.startswith(b"#"):
            continue
        m = re.search(rb"[:=]", line)
        if not m:
            fail(2, "passwd-file: missing colon")
        value = unescape(line[m.end():])
        try:
            if b"\0" in value:
                raise UnicodeError
            pwds[line[:m.start()].strip(SPACE).decode()] = value.decode()
        except UnicodeError:
            fail(2, "passwd-file: value is not valid UTF-8")
    return pwds


def load(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except (FileNotFoundError, TypeError):
        return default


def fail(rc, msg):
    sys.stderr.write("Error: " + msg + "\n")
    sys.exit(rc)


def main(argv):
    with open(os.environ["FAKE_NMCLI_LOG"], "a") as f:
        f.write(json.dumps(argv) + "\n")
    raw = os.environ.get("FAKE_NMCLI_SCENARIO", "{}")
    scenario = json.loads(raw) if raw.lstrip().startswith("{") else load(raw, {})
    state_path = os.environ["FAKE_NMCLI_STATE"]
    state = load(state_path, {"profiles": []})
    profiles = state["profiles"]

    while argv and argv[0].startswith("-") and argv[0] not in ("-t", "-f"):
        argv = argv[2:] if argv[0] in ("--wait", "-g") else argv[1:]
    if argv[:1] == ["-t"]:
        argv = argv[3:] if argv[1] == "-f" else argv[1:]

    def find(sel):
        # A bare selector matches a uuid or a name, as nmcli's does.
        keys = {"uuid": ("uuid",), "id": ("name",)}.get(sel[0], ("uuid", "name"))
        for p in profiles:
            if any(p[k] == sel[-1] for k in keys):
                return p
        fail(NOT_FOUND, "unknown connection '%s'." % sel[-1])

    if argv == ["radio", "wifi", "on"]:
        return
    if argv[:3] == ["device", "wifi", "list"]:
        for row in scenario.get("scan", []):
            esc = [str(row[k]).replace("\\", "\\\\").replace(":", "\\:")
                   for k in ("ssid", "signal", "security")]
            print(":".join(esc))
        return
    if argv[:2] == ["device", "show"]:
        print(scenario.get("ip4", ""))
        return
    if argv[:2] == ["connection", "show"]:
        for p in profiles:
            print(p["uuid"] + ":" + p["type"])
        return
    if argv[:2] == ["connection", "add"]:
        props = dict(zip(argv[2::2], argv[3::2]))
        profiles.append({"uuid": props["connection.uuid"], "name": props["con-name"],
                         "type": "802-11-wireless", "save": props.get("save", "yes"),
                         "ap": props.get("802-11-wireless.mode") == "ap",
                         "active": False})
        if "wifi-sec.psk-flags" in props:
            profiles[-1]["psk_flags"] = int(props["wifi-sec.psk-flags"])
    elif argv[:2] == ["connection", "up"]:
        p = find(argv[2:4] if argv[2] in ("uuid", "id") else argv[2:3])
        psk = None
        if "passwd-file" in argv:
            pwds = read_passwd_file(argv[argv.index("passwd-file") + 1])
            psk = pwds.get("802-11-wireless-security.psk")
            p["secret_supplied"] = psk is not None
        join = scenario.get("join", {})
        if p["ap"] and scenario.get("ap_up", "ok") != "ok":
            fail(4, "Connection activation failed: (10) The device could not be readied.")
        if not p["ap"] and "exit" in join:
            fail(join["exit"], join.get("stderr", ""))
        if not p["ap"] and "correct_psk" in join and psk != join["correct_psk"]:
            fail(4, "Connection activation failed: (7) Secrets were required, "
                    "but not provided.")
        p["active"] = True
    elif argv[:2] == ["connection", "down"]:
        p = find(argv[2:4] if argv[2] in ("uuid", "id") else argv[2:3])
        p["active"] = False
    elif argv[:2] == ["connection", "delete"]:
        sels = [argv[2:4]] if argv[2] in ("uuid", "id") else [[a] for a in argv[2:]]
        for sel in sels:
            profiles.remove(find(sel))
    else:
        fail(2, "fake-nmcli: unsupported argv %r" % argv)
    with open(state_path, "w") as f:
        json.dump(state, f)


if __name__ == "__main__":
    main(sys.argv[1:])
