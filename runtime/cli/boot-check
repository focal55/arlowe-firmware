#!/bin/bash
# Arlowe Boot Verification Script
# Run after reboot to verify all services are operational
#
# Env overrides:
#   ARLOWE_SYSTEMCTL_FLAGS  Flags passed to systemctl
#                           Default: '' (system-level units, Phase 3+ image)
#                           Set to '--user' for ad-hoc test invocations
#                           against legacy --user units in dev-stash/.
#   ARLOWE_ROOT             Filesystem prefix for the IDENTITY section.
#                           Default: '' (the live root). Set to a temp tree to
#                           exercise the section off-device.
#   ARLOWE_IDENTITY_OWNER   Expected owner:group of the identity store.
#                           Default: 'arlowe:arlowe'.

# Phase 3 plan 04: default flipped from '--user' to '' to align with
# the system-level unit files shipped in plan 03-02.
SYSTEMCTL_FLAGS="${ARLOWE_SYSTEMCTL_FLAGS:-}"

echo "============================================================"
echo "           ARLOWE BOOT VERIFICATION"
echo "============================================================"
echo ""

PASS=0
FAIL=0

check_service() {
    local svc=$1
    local desc=$2
    if systemctl $SYSTEMCTL_FLAGS is-active --quiet $svc; then
        echo "OK  $desc"
        ((PASS++))
    else
        echo "FAIL $desc"
        ((FAIL++))
    fi
}

check_port() {
    local port=$1
    local desc=$2
    if lsof -ti :$port >/dev/null 2>&1; then
        echo "OK  $desc (port $port)"
        ((PASS++))
    else
        echo "FAIL $desc (port $port NOT listening)"
        ((FAIL++))
    fi
}

# Identity store sentinel (Phase 7, plan 07-04). Writes structured JSON to
# /var/lib/arlowe/state/identity-selfcheck.json for the Phase 11 dashboard
# health view, mirroring the audio-selfcheck.json precedent from Phase 5.
ARLOWE_ROOT="${ARLOWE_ROOT:-}"
ARLOWE_IDENTITY_OWNER="${ARLOWE_IDENTITY_OWNER:-arlowe:arlowe}"

id_mode()  { stat -c '%a' "$1" 2>/dev/null || stat -f '%Lp' "$1" 2>/dev/null; }
id_owner() { stat -c '%U:%G' "$1" 2>/dev/null || stat -f '%Su:%Sg' "$1" 2>/dev/null; }

check_identity() {
    local idir="${ARLOWE_ROOT}/var/lib/arlowe/identity"
    local statedir="${ARLOWE_ROOT}/var/lib/arlowe/state"
    local paired=false dir_ok=false modes_ok=true opt_clean=true
    local id_present=false key_present=false cert_present=false
    local mode owner f path hits

    # An absent /etc/arlowe/config.yml is the Phase 4 CONFIG-03 pre-pairing
    # signal. Before pairing, missing identity material is the correct state.
    [ -f "${ARLOWE_ROOT}/etc/arlowe/config.yml" ] && paired=true

    if [ -d "$idir" ]; then
        mode=$(id_mode "$idir")
        owner=$(id_owner "$idir")
        if [ "$mode" = "700" ] && [ "$owner" = "$ARLOWE_IDENTITY_OWNER" ]; then
            dir_ok=true
            echo "OK  Identity store ($owner 0$mode)"
            ((PASS++))
        else
            modes_ok=false
            echo "FAIL Identity store is $owner 0$mode, expected $ARLOWE_IDENTITY_OWNER 0700"
            ((FAIL++))
        fi
    else
        echo "FAIL Identity store missing: /var/lib/arlowe/identity"
        ((FAIL++))
    fi

    for f in device-id device.key device.crt; do
        path="$idir/$f"
        if [ -e "$path" ]; then
            case "$f" in
                device-id)  id_present=true ;;
                device.key) key_present=true ;;
                device.crt) cert_present=true ;;
            esac
            mode=$(id_mode "$path")
            if [ "$mode" = "600" ]; then
                echo "OK  $f present (0600)"
                ((PASS++))
            else
                modes_ok=false
                echo "FAIL $f is 0$mode, expected 0600"
                ((FAIL++))
            fi
        elif [ "$paired" = false ]; then
            echo "OK  $f absent (not yet paired)"
            ((PASS++))
        else
            echo "WARN $f absent on a paired device"
        fi
    done

    # Predicate list mirrors IDENTITY_MATERIAL_GLOBS in
    # scripts/lib/identity-store-check.sh, which is the authority the two must
    # agree on; scripts/lib/ is a build-host library, not installed on device.
    hits=$(find "${ARLOWE_ROOT}/opt/arlowe" \( -type f -o -type l \) \
        \( -name '*.key' -o -name '*.pem' -o -name '*.crt' -o -name '*.csr' \
           -o -name '*.p12' -o -name '*.pfx' -o -name 'device-entropy' \
           -o -name 'device-id' -o -name 'identity.json' \) -print 2>/dev/null)
    if [ -n "$hits" ]; then
        opt_clean=false
        echo "FAIL Identity material under /opt/arlowe:"
        while IFS= read -r path; do echo "     $path"; done <<< "$hits"
        ((FAIL++))
    else
        echo "OK  No identity material under /opt/arlowe"
        ((PASS++))
    fi

    if [ -d "$statedir" ]; then
        # 0644: a status file the dashboard reads, not a secret.
        (umask 0022
         printf '{"paired": %s, "identity_dir_ok": %s, "device_id_present": %s, "key_present": %s, "cert_present": %s, "modes_ok": %s, "opt_arlowe_clean": %s, "checked_at": "%s"}\n' \
            "$paired" "$dir_ok" "$id_present" "$key_present" "$cert_present" \
            "$modes_ok" "$opt_clean" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
            > "$statedir/identity-selfcheck.json")
        echo "OK  Wrote identity-selfcheck.json"
        ((PASS++))
    else
        echo "WARN State dir absent; skipped identity-selfcheck.json"
    fi
}

echo "CORE SERVICES:"
echo "------------------------------------------------------------"
check_service qwen-tokenizer "Qwen Tokenizer"
check_service qwen-api "Qwen LLM API"
check_service qwen-openai "Qwen OpenAI Wrapper"
check_service whisper-stt "Whisper STT Server"
check_service arlowe-face "Face Display Service"
check_service arlowe-voice "Voice Assistant"
check_service arlowe-dashboard "Arlowe Dashboard"

echo ""
echo "NETWORK ENDPOINTS:"
echo "------------------------------------------------------------"
check_port 12345 "Tokenizer Service"
check_port 8000 "Qwen Native API"
check_port 8001 "Qwen OpenAI API"
check_port 8082 "STT Server"
check_port 8080 "Face Control API"
check_port 3000 "Dashboard"

echo ""
echo "HARDWARE:"
echo "------------------------------------------------------------"
if /usr/bin/axcl/axcl-smi >/dev/null 2>&1; then
    echo "OK  Axera NPU detected"
    ((PASS++))
else
    echo "FAIL Axera NPU not responding"
    ((FAIL++))
fi

# Audio capture+playback sentinel via auto-detected device (Phase 5, plan 05-06).
# Writes structured JSON to /var/lib/arlowe/state/audio-selfcheck.json for
# Phase 11 dashboard health view; /tmp echo is for the human-readable report.
# WARN (not FAIL) on audio degraded — functional-degraded over hard block.
ARLOWE_LIB="${ARLOWE_LIB:-/opt/arlowe/runtime/lib}"
if PYTHONPATH="$ARLOWE_LIB" python3 -m arlowe_audio --selfcheck >/tmp/arlowe-audio-selfcheck.json; then
    echo "OK  Audio capture + playback sentinel"
    ((PASS++))
else
    echo "WARN Audio sentinel degraded (see journal: [arlowe-audio])"
fi

echo ""
echo "IDENTITY:"
echo "------------------------------------------------------------"
check_identity

echo ""
echo "============================================================"
echo "Results: $PASS passed, $FAIL failed"
if [ $FAIL -eq 0 ]; then
    echo "ALL SYSTEMS OPERATIONAL"
else
    echo "Some services need attention"
fi
