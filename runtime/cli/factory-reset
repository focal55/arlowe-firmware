#!/usr/bin/python3
"""
factory-reset -- return the unit to its unpaired, out-of-box state (ADR-0013).

Runs as root: `--trigger dashboard|button` starts a reset, `--resume` finishes one a
power cut interrupted (the boot-time resume unit runs it when the marker exists).
If a marker already exists, `--trigger` also resumes it, keeping its original trigger.

Order is ADR-0013's and is load-bearing:
  marker -> stop units -> revoke (best effort) -> rm config.yml -> Wi-Fi profiles
  -> identity -> state dirs -> journal -> hostname -> audit line -> reboot.
Removing /etc/arlowe/config.yml is the commit point: from that step on the six
units' ConditionPathExists fails and the next boot pairs.

The marker, reset-ledger/in-progress, holds {"trigger", "started_at", "step",
"revoke"} and is rewritten with fsync after every step, so a resume skips what is
done. A step that ran but was not recorded reruns, so every step is idempotent.

Testing hooks (not for use on a device):
  ARLOWE_ROOT              prefixes every filesystem path; external commands are
                           found on PATH so tests can shim them. Ownership is only
                           set when ARLOWE_ROOT is unset.
  ARLOWE_RESET_FAIL_AFTER  raise after step N (1-based) runs and before it is
                           recorded; exists for the resume-from-every-step test.
  ARLOWE_RESET_REVOKE_TIMEOUT  seconds the revoke may take (default 20).
  ARLOWE_BROKER_FILE       the FAT broker file, ARLOWE_ROOT-prefixed like every path.
  --no-reboot              skip the final `systemctl reboot`.

Never logs file contents.
"""

import argparse
import glob
import json
import logging
import os
import shutil
import signal
import subprocess
import sys
import tempfile
from datetime import datetime, timezone
from pathlib import Path

import yaml

sys.path.insert(0, os.environ.get("ARLOWE_LIB", "/opt/arlowe/runtime/lib"))

from arlowe_broker import resolve_broker  # noqa: E402

ROOT = os.environ.get("ARLOWE_ROOT", "")
TRIGGERS = ("dashboard", "button")
UNITS = ("arlowe-dashboard.service", "arlowe-face.service", "arlowe-voice.service",
         "qwen-api.service", "qwen-tokenizer.service", "whisper-stt.service",
         "arlowe-pair.service")
# Owners and modes mirror scripts/provision/install-arlowe-fs.sh; keep them in step.
WIPED = ("conversations", "wake-word", "state", "dashboard", "logs", "cache")
SKELETON = (("conversations", 0o700), ("identity", 0o700), ("wake-word", 0o750),
            ("state", 0o750), ("dashboard", 0o750), ("dashboard/cache", 0o750),
            ("logs", 0o750), *((f"logs/{s}", 0o750) for s in
                               ("voice", "face", "stt", "tts", "llm", "dashboard")),
            ("cache", 0o750), ("cache/huggingface", 0o750))
HOSTNAME = "arlowe"


def path(p):
    return Path(ROOT + p)


STATE = path("/var/lib/arlowe")
LEDGER = STATE / "reset-ledger"
MARKER = LEDGER / "in-progress"
AUDIT = LEDGER / "resets.log"
ORPHANS = LEDGER / "orphaned-certs.jsonl"
CONFIG = path("/etc/arlowe/config.yml")
IDENTITY = path("/var/lib/arlowe/identity/identity.json")
BROKER_FILE = path(os.environ.get("ARLOWE_BROKER_FILE", "/boot/firmware/arlowe-broker.json"))
REVOKE_TIMEOUT = float(os.environ.get("ARLOWE_RESET_REVOKE_TIMEOUT", "20"))
REVOKE_REASONS = {3: "rejected", 4: "unavailable", 5: "local_state"}
NM_STATE = path("/var/lib/NetworkManager")
HOSTS = path("/etc/hosts")


def log(msg):
    print("factory-reset: " + msg, file=sys.stderr, flush=True)


def run(*argv):
    subprocess.run(argv, check=True, stdout=subprocess.PIPE)


def fsync_dir(d):
    fd = os.open(d, os.O_RDONLY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def write_atomic(target, text, mode):
    tmp = target.with_name(target.name + ".tmp")
    with open(tmp, "w") as f:
        f.write(text)
        f.flush()
        os.fsync(f.fileno())
    os.chmod(tmp, mode)
    os.replace(tmp, target)
    fsync_dir(target.parent)


def save_marker(ctx):
    write_atomic(MARKER, json.dumps(ctx, sort_keys=True) + "\n", 0o600)


def stop_units(ctx):
    rc = subprocess.run(["systemctl", "stop", *UNITS]).returncode
    # 5 is "unit not loaded" (arlowe-pair is absent on images without it). Anything else
    # may mean a service is still running and writing the state the wipe removes.
    if rc == 5:
        log("systemctl stop exited 5; a unit is not installed, continuing")
    elif rc:
        raise RuntimeError("systemctl stop exited %d" % rc)


def _now():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def _provisioning_url():
    try:
        config = yaml.safe_load(CONFIG.read_text()) or {}
        return str((config.get("identity") or {}).get("provisioning_url") or "").strip()
    except (OSError, yaml.YAMLError, AttributeError):
        return ""


def _run_revoke(url, ca_path):
    """Return None on success, else the failure reason recorded in the orphan ledger."""
    env = dict(os.environ)
    env.pop("ARLOWE_BROKER_CA_BUNDLE", None)
    if ca_path:
        env["ARLOWE_BROKER_CA_BUNDLE"] = str(ca_path)
    # Own session so a timeout kills the whole group: a surviving grandchild holding
    # stdout open would block communicate() past the timeout.
    proc = subprocess.Popen(["arlowe-identity", "revoke", "--json", "--ca-broker-url", url],
                            stdout=subprocess.PIPE, env=env, text=True, start_new_session=True)
    try:
        out, _ = proc.communicate(timeout=REVOKE_TIMEOUT)
    except subprocess.TimeoutExpired:
        try:
            os.killpg(proc.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        proc.communicate()
        return "timeout"
    if proc.returncode == 0:
        return None
    try:
        error = json.loads(out).get("error")
    except (ValueError, AttributeError):
        error = None
    return error or REVOKE_REASONS.get(proc.returncode, "exit_%d" % proc.returncode)


def _record_orphan(meta, reason):
    entry = {k: meta.get(k) for k in ("certificate_id", "thing_name", "device_id")}
    line = json.dumps({**entry, "at": _now(), "reason": reason}, sort_keys=True)
    fd = os.open(ORPHANS, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
    with os.fdopen(fd, "a") as f:
        f.write(line + "\n")
        f.flush()
        os.fsync(f.fileno())
    fsync_dir(LEDGER)


def revoke_or_record(ctx):
    """Best-effort certificate revoke: "ok" | "failed" | "skipped" (ADR-0013 step 3).

    Runs before the commit point, so config.yml still names the broker. Every failure
    leaves an orphaned-certs line; nothing is ever silently abandoned.
    """
    try:
        meta = json.loads(IDENTITY.read_text())
    except (OSError, ValueError):
        meta = {}
    if not isinstance(meta, dict) or not meta.get("certificate_id"):
        return "skipped"
    ca_dir = tempfile.mkdtemp(prefix="arlowe-reset-")
    try:
        broker = resolve_broker(BROKER_FILE, _provisioning_url(), ca_dir)
        reason = _run_revoke(*broker) if broker else "no_broker_url"
    except OSError as exc:
        reason = "local_error"
        log("revoke could not run: %s" % exc.strerror)
    finally:
        shutil.rmtree(ca_dir, ignore_errors=True)
    if reason is None:
        return "ok"
    log("revoke failed (%s); recording certificate in the orphan ledger" % reason)
    _record_orphan(meta, reason)
    return "failed"


def revoke(ctx):
    ctx["revoke"] = revoke_or_record(ctx)


def commit(ctx):
    CONFIG.unlink(missing_ok=True)
    fsync_dir(CONFIG.parent)


def forget_networks(ctx):
    listing = subprocess.run(["nmcli", "-t", "-f", "UUID,TYPE", "connection", "show"],
                             check=True, stdout=subprocess.PIPE, text=True).stdout
    wifi = [uuid for uuid, _, kind in (line.rpartition(":") for line in listing.splitlines())
            if kind == "802-11-wireless"]
    if wifi:
        run("nmcli", "connection", "delete", *wifi)
    for name in ("seen-bssids", "timestamps", *glob.glob("*.lease", root_dir=NM_STATE)):
        (NM_STATE / name).unlink(missing_ok=True)


def reset_identity(ctx):
    run("arlowe-identity", "reset", "--force")


def empty(d):
    for child in d.iterdir() if d.is_dir() else ():
        if child.is_dir() and not child.is_symlink():
            shutil.rmtree(child)
        else:
            child.unlink()


def wipe_state(ctx):
    for name in WIPED:
        empty(STATE / name)
    for rel, mode in SKELETON:
        d = STATE / rel
        d.mkdir(exist_ok=True)
        os.chmod(d, mode)
        if not ROOT:
            shutil.chown(d, "arlowe", "arlowe")


def vacuum_journal(ctx):
    run("journalctl", "--rotate")
    run("journalctl", "--vacuum-time=1s")


def reset_hostname(ctx):
    run("hostnamectl", "set-hostname", HOSTNAME)
    lines = HOSTS.read_text().splitlines() if HOSTS.exists() else []
    kept = [line for line in lines if not line.split()[:1] == ["127.0.1.1"]]
    write_atomic(HOSTS, "\n".join(kept + ["127.0.1.1\t" + HOSTNAME]) + "\n", 0o644)


def audit(ctx):
    # `at` is the reset's start time, so a rerun of this step can recognise its own line.
    line = json.dumps({"at": ctx["started_at"], "trigger": ctx["trigger"],
                       "revoke": ctx["revoke"]}, sort_keys=True)
    if AUDIT.exists() and line in AUDIT.read_text().splitlines()[-1:]:
        return
    with open(AUDIT, "a") as f:
        f.write(line + "\n")
        f.flush()
        os.fsync(f.fileno())


STEPS = (("stop", stop_units), ("revoke", revoke), ("commit", commit),
         ("network", forget_networks), ("identity", reset_identity),
         ("wipe", wipe_state), ("journal", vacuum_journal),
         ("hostname", reset_hostname), ("audit", audit))


def parse_args(argv):
    parser = argparse.ArgumentParser(prog="factory-reset", description=__doc__.split("\n")[1])
    mode = parser.add_mutually_exclusive_group(required=True)
    mode.add_argument("--trigger", choices=TRIGGERS)
    mode.add_argument("--resume", action="store_true",
                      help="finish an interrupted reset; no marker means nothing to do")
    parser.add_argument("--no-reboot", action="store_true", help="tests only")
    return parser.parse_args(argv)


def main(argv):
    args = parse_args(argv)
    logging.basicConfig(level=logging.INFO, format="factory-reset: %(message)s")
    if MARKER.exists():
        ctx = json.loads(MARKER.read_text())
        log("resuming %s reset after step %d" % (ctx["trigger"], ctx["step"]))
    elif args.resume:
        log("no reset in progress")
        return 0
    else:
        LEDGER.mkdir(mode=0o700, parents=True, exist_ok=True)
        os.chmod(LEDGER, 0o700)
        ctx = {"trigger": args.trigger, "step": 0, "revoke": "skipped",
               "started_at": _now()}
        save_marker(ctx)
        log("starting %s reset" % args.trigger)
    fail_after = int(os.environ.get("ARLOWE_RESET_FAIL_AFTER", "0"))
    for index, (name, fn) in enumerate(STEPS, start=1):
        if index <= ctx["step"]:
            continue
        log("step %d/%d: %s" % (index, len(STEPS), name))
        fn(ctx)
        if index == fail_after:
            raise RuntimeError("injected failure after step %d" % index)
        ctx["step"] = index
        save_marker(ctx)
    MARKER.unlink()
    fsync_dir(LEDGER)
    os.sync()
    log("done; revoke %s" % ctx["revoke"])
    if not args.no_reboot:
        run("systemctl", "reboot")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except (OSError, subprocess.CalledProcessError, RuntimeError) as exc:
        log("aborted, marker kept for --resume: %s" % exc)
        sys.exit(1)
