[Unit]
Description=Arlowe local dashboard (Next.js standalone)
After=network.target

[Service]
Type=simple
User=arlowe
Group=arlowe
WorkingDirectory=/opt/arlowe/runtime/dashboard
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=0.0.0.0
Environment=NEXT_TELEMETRY_DISABLED=1
Environment=NEXT_PRIVATE_CACHE_DIR=/var/lib/arlowe/dashboard/cache
Environment=ARLOWE_CONFIG_PATH=/etc/arlowe/config.yml
Environment=ARLOWE_LOGS_DIR=/var/lib/arlowe/logs
Environment=ARLOWE_SYSTEMCTL_MODE=system
# The vendored Node from third_party/node/manifest.yml, named by ABSOLUTE PATH and
# unconditionally — not /usr/bin/node, and not `node` off PATH. next@16.1.6 declares
# engines.node ">= 20.9.0"; bookworm's nodejs is 18.20.4 and backports carries none,
# so apt cannot satisfy the floor (ADR-0008). `nodejs`/`npm` are dropped from
# 00-packages-nr, so this is the only Node in the image. Naming it explicitly is what
# makes plan 07.1-03's verify_unit_runtime_versions able to assert the floor at all:
# an existence-only path check cannot tell a Node 24 from a Node 18, and under the
# old /usr/bin/node line this unit PASSED every gate while the dashboard never started.
# This path, the prefix build-dashboard.sh unpacks to, and the manifest's node_bin
# field are one fact written three places — change them together.
ExecStart=/opt/arlowe/node/bin/node /opt/arlowe/runtime/dashboard/server.js
Restart=on-failure
RestartSec=5

# Sandbox hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
PrivateDevices=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# @system-service permits mbind, but the ~@resources deny above removes it.
# Raspberry Pi 5 boots with numa=fake=8 numa_policy=interleave, so glibc and
# native extensions call mbind(2) during import to honour the interleave
# policy; seccomp then kills the process with SIGSYS before it reaches main.
# Re-admit only mbind rather than dropping the whole @resources deny.
SystemCallFilter=mbind
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# ADR-0003: /etc/arlowe added to ReadWritePaths (scoped to that path only — not
# a broader /etc). The dashboard POST /api/config route writes the overlay via
# temp-file + rename directly. All other sandbox hardening is unchanged.
ReadWritePaths=/var/lib/arlowe/dashboard /var/lib/arlowe/logs/dashboard /etc/arlowe

[Install]
WantedBy=multi-user.target
