// Arlowe Phase 8: let the `arlowe` service user drive NetworkManager for
// pairing (setup AP, join the owner's network) and the dashboard's Wi-Fi routes.
//
// Action IDs and defaults are read from the Pi-archive network-manager
// 1.42.4-1+rpt1+deb12u1 deb (usr/share/polkit-1/actions/
// org.freedesktop.NetworkManager.policy). A systemd service has no session, so
// polkit evaluates allow_any, and every action below defaults to deny or
// auth_admin with no agent present.
//
// wifi.share.protected only: the setup AP is WPA2 (ADR-0011), so the open-AP
// action is deliberately not granted.
polkit.addRule(function(action, subject) {
    if (subject.user !== "arlowe") return;
    var allowed = [
        "org.freedesktop.NetworkManager.network-control",
        "org.freedesktop.NetworkManager.settings.modify.system",
        "org.freedesktop.NetworkManager.wifi.share.protected",
        "org.freedesktop.NetworkManager.wifi.scan",
        "org.freedesktop.NetworkManager.enable-disable-wifi"
    ];
    if (allowed.indexOf(action.id) >= 0) return polkit.Result.YES;
});
