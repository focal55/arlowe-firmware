# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.next/
.turbo/
.vercel/
out/

# Env / secrets
.env
.env.*
!.env.example

# Local state
.DS_Store
*.log
.cache/
coverage/
.nyc_output/
*.tsbuildinfo

# Editor
.vscode/
.idea/
*.swp
*.swo

# OS
Thumbs.db

# Project board / planning local state
.planning/.cache/

# === Phase 1 Runtime Extraction ===
# Founder voice biometric data must NEVER enter this repo (research R6).
*.pkl
runtime/wake-word/positive/
runtime/wake-word/negative/
runtime/wake-word/*.pkl

# Local dev stash from scripts/dev-pull-from-pi.sh — never commit live Pi mirrors.
.dev-stash/

# === Vendored third-party artifacts (fetch-at-build; NEVER commit) ===
# Obtained at build time per each dir's INSTALL.md; keep only the docs/manifests.
third_party/whisplay-driver/WhisPlay.py
third_party/whisplay-driver/LICENSE
third_party/whisplay-driver/install_wm8960_drive.sh
third_party/whisplay-driver/WM8960-Audio-HAT*
third_party/axcl/*.deb
# Node runtime tarball (ADR-0008). third_party/node/INSTALL.md tells the builder to place
# it here, so without this rule a ~30 MB binary lands in a commit. Keep manifest.yml + docs.
third_party/node/*.tar.xz
third_party/node/*.tar.gz
# Pinned kernel debs (ADR-0009). third_party/kernel/INSTALL.md names this directory as a
# staging location, and the six debs total ~75 MiB. Keep manifest.yml + INSTALL.md.
third_party/kernel/*.deb

# Standard Python / Next.js noise that will accumulate in runtime/ subtrees.
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
node_modules/
.next/
.env.local
.env.*.local

# === Phase 7 staging PKI (scripts/pki/) ===
# The IoT credentials endpoint is <account-specific-prefix>.credentials.iot.<region>
# .amazonaws.com and the role ARN embeds the 12-digit account id. Neither literal is on
# scripts/sanitize/banlist.txt, so the sanitize gate will NOT catch a committed one.
# These reach a device only via identity.* config or the provisioning response.
scripts/pki/.staging-env
scripts/pki/*.pem

# Upstream pi-gen is provisioned at a pinned tag by scripts/build-image.sh;
# only the arlowe overlay is tracked.
/pi-gen/*
!/pi-gen/config
!/pi-gen/stage-arlowe
